{
  "version": "5.0",
  "ruleset_id": "semekome-prototype-0.4-facing-castles",
  "status": "registered_release_candidate",
  "required_for_initial_public_release": true,
  "source_document": "RESULTS_SCORE_RANKING.md",
  "standard_reference": {
    "url": "https://github.com/chameleonjp-lab/chameleonjp_lab/blob/main/docs/chameleonjp-lab/11_ranking_integration_standard.md",
    "checked_at": "2026-10-02",
    "verification": "2026-09-28版の全文と実RPC定義・anon権限を確認。公開作業はRELEASE_CHECKLIST.mdの記録を参照。"
  },
  "connection": {
    "game_id": "semekome",
    "game_slug": "semekome_standard_v1",
    "public_game_url": "https://chameleonjp-lab.github.io/semekome/",
    "start_endpoint": "start_game_play_v1",
    "result_endpoint": [
      "finish_game_play_v1",
      "submit_score_idempotent_v1"
    ],
    "fetch_endpoint": "get_game_ranking",
    "auth_mode": "publishable_key",
    "public_key": "公開ビルド用の.env.production（manifestには入れない）",
    "database_registration": "registered_inactive"
  },
  "events": {
    "start": {
      "send_policy": "automatic_after_name_confirm_and_start_success",
      "idempotency_key": "start_id",
      "payload_contract": "共通規約v1の名前・game_slug・client_version。サーバー発行play_idを保存する。",
      "retry_policy": "same_identifier_and_same_payload_only"
    },
    "result": {
      "send_policy": "automatic_for_eligible_terminal_result",
      "idempotency_key": "submission_id",
      "payload_contract": "確定スコア・開門数・終局種別。p_reached_waveは開門数+1（1〜8）。",
      "retry_policy": "same_identifier_and_same_payload_only"
    }
  },
  "client_states": [
    "idle",
    "submitting",
    "submitted",
    "retryable_failed",
    "permanent_failed"
  ],
  "display": {
    "initial_ranking": "best_top_10",
    "same_rank_policy": "RPCのrank_noを使い最大10件",
    "zero_rows": "show_empty_state",
    "fetch_failure": "show_failure_state_without_fabricated_rows",
    "loading": "show_loading_state",
    "local_history_is_not_world_ranking": true
  },
  "security_and_validation": {
    "secret_key_in_browser": false,
    "server_validates_input_limits": true,
    "server_validates_ruleset_version": "開始と終了のclient_version一致を検査。shared方式は任意クライアントの改変得点を保証しない。",
    "server_deduplicates_start_and_result": true,
    "client_score_is_not_tamper_proof_without_replay_validation": true
  },
  "unresolved_null_values_ja": "連携の識別子は新規登録用のmanifestで固定した。実機・試遊の受入は未実施。"
}
